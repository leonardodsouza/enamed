{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enamed",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "enamed",
      "database_id": "9059e441-c058-4860-bf0c-5b710ecb609b",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PRECO_MENSAL": "49.90",
    "DIAS_POR_PAGAMENTO": "30",
    // Deixe vazio para usar o endereço de onde o site foi acessado
    "URL_BASE": ""
  }
}
